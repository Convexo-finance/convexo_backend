generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Supabase: runtime/client uses the transaction-mode pooler (DATABASE_URL, :6543, pgbouncer);
  // `prisma migrate`/`db` use the session-mode pooler (DIRECT_URL, :5432). DIRECT_URL is only
  // read by migration commands — set it to the same value as DATABASE_URL for plain local Postgres.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════════

enum AccountType {
  INDIVIDUAL
  BUSINESS
}

enum AuthMethod {
  EMAIL
  PASSKEY
  GOOGLE
  WALLET_CONNECT
  METAMASK
  COINBASE
  EXTERNAL_EOA
}

enum OnboardingStep {
  NOT_STARTED
  TYPE_SELECTED
  PROFILE_COMPLETE
  HUMANITY_PENDING
  HUMANITY_COMPLETE
  KYC_PENDING
  KYB_PENDING
  LP_COMPLETE
  CREDIT_SCORE_PENDING
  COMPLETE
}

enum CompanySize {
  MICRO
  SMALL
  MEDIUM
  LARGE
}

enum VerificationType {
  HUMANITY
  KYC_INDIVIDUAL
  KYB_BUSINESS
  CREDIT_SCORE
}

enum VerificationProvider {
  ZKPASSPORT
  VERIFF
  SUMSUB
  INTERNAL
}

enum VerificationStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  EXPIRED
  RESUBMISSION_REQUESTED
}

enum CreditScoreStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  NFT_REQUESTED
  COMPLETE
  // Custom doc-upload flow (P4 — v3.28) — pre-submit draft lifecycle
  DRAFT
  EXTRACTING
  READY_FOR_REVIEW
  SCORE_COMPUTED
  MINTED
}

enum BankAccountType {
  SAVINGS
  CHECKING
  BUSINESS
}

enum BankAccountStatus {
  PENDING
  VERIFIED
  REJECTED
  DISABLED
}

enum ContactType {
  PROVIDER
  FRIEND
  CLIENT
  FAMILY
  OTHER
}

enum DocumentCategory {
  GENERAL
  VAULT_CONTRACT
  KYC_DOCUMENT
  KYB_DOCUMENT
  INCOME_STATEMENT
  BALANCE_SHEET
  CASH_FLOW
  CREDIT_SCORE_REQUEST
  FUNDING_REQUEST
  NFT_METADATA
}

enum OtcOrderType {
  BUY
  SELL
}

enum OtcOrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FundingRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  VAULT_CREATED
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
}

enum AdminRoleType {
  VIEWER
  VERIFIER
  SUPER_ADMIN
}

// ═══════════════════════════════════════════════════════════════════════════════
// USER
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id             String         @id @default(cuid())
  walletAddress  String         @unique
  smartAccount   String?        @unique
  authMethod     AuthMethod     @default(EXTERNAL_EOA)
  chainId        Int            @default(8453)
  nonce          String?

  accountType    AccountType?
  onboardingStep OnboardingStep @default(NOT_STARTED)
  onboardedAt    DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  individualProfile   IndividualProfile?
  businessProfile     BusinessProfile?
  reputation          ReputationCache?
  verifications       Verification[]
  creditScoreRequests CreditScoreRequest[]
  bankAccounts        BankAccount[]
  contacts            Contact[]
  documents           Document[]
  otcOrders           OtcOrder[]
  fundingRequests     FundingRequest[]
  notifications       NotificationLog[]
  adminRole           AdminRole?
  kybSubmissions      KybSubmission[]
  kycSubmissions      KycSubmission[]
}

// ═══════════════════════════════════════════════════════════════════════════════
// INDIVIDUAL PROFILE
// ═══════════════════════════════════════════════════════════════════════════════

model IndividualProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName          String?
  lastName           String?
  displayName        String?
  dateOfBirth        DateTime?
  nationality        String?
  countryOfResidence String?

  email              String?
  phone              String?
  telegram           String?
  twitter            String?
  linkedin           String?
  avatarUrl          String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// BUSINESS PROFILE
// ═══════════════════════════════════════════════════════════════════════════════

model BusinessProfile {
  id                 String      @id @default(cuid())
  userId             String      @unique
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName        String?
  legalName          String?
  taxId              String?
  registrationNumber String?
  industry           String?
  companySize        CompanySize?
  foundedYear        Int?
  website            String?
  description        String?

  country            String?
  city               String?
  address            String?
  postalCode         String?

  email              String?
  phone              String?
  telegram           String?
  linkedin           String?
  logoUrl            String?

  repFirstName       String?
  repLastName        String?
  repTitle           String?
  repEmail           String?
  repPhone           String?

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// REPUTATION CACHE
// ═══════════════════════════════════════════════════════════════════════════════

model ReputationCache {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier                  Int      @default(0)
  tierName              String   @default("None")

  passportBalance       String   @default("0")
  lpIndividualsBalance  String   @default("0")
  lpBusinessBalance     String   @default("0")
  ecreditscoringBalance String   @default("0")

  canAccessTreasury     Boolean  @default(false)
  canInvestInVaults     Boolean  @default(false)
  canAccessLPPools      Boolean  @default(false)
  canRequestCreditScore Boolean  @default(false)
  canCreateVaults       Boolean  @default(false)
  canAccessFunding      Boolean  @default(false)

  lastSyncedAt          DateTime @default(now())
  syncedFromChainId     Int      @default(8453)
}

// ═══════════════════════════════════════════════════════════════════════════════
// VERIFICATION
// ═══════════════════════════════════════════════════════════════════════════════

model Verification {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  type            VerificationType
  provider        VerificationProvider
  sessionId       String               @unique
  status          VerificationStatus   @default(PENDING)

  veriffUrl       String?
  applicantId     String?
  levelName       String?
  zkProofHash     String?

  rejectionReason String?
  nftTokenId      String?
  processedAt     DateTime?
  processedBy     String?

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// KYB SUBMISSION (manual — admin reviews)
// ═══════════════════════════════════════════════════════════════════════════════

model KybSubmission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName         String
  country             String
  companyType         String
  incorporationNumber String
  taxNumber           String
  street              String
  city                String
  stateRegion         String?
  officeCountry       String
  repFirstName        String
  repLastName         String
  repDocType          String
  repDocNumber        String
  repEmail            String
  repPhone            String
  shareholders        Json

  documents  SubmissionDocument[]

  // ─── P2 (v3.27) — custom KYB flow with Claude extraction ───────────────────
  // status now also accepts: 'DRAFT' | 'EXTRACTING' | 'READY_FOR_REVIEW' | 'MINTED'
  // (String, not enum — no migration required to add values).
  controllerFirstName    String?
  controllerLastName     String?
  controllerEmail        String?
  controllerPhone        String?
  controllerRelationship String?  // 'CEO' | 'CFO' | 'AUTHORIZED_SIGNER' | 'OTHER'
  controllerWallet       String?  // must match the connected wallet at submit time
  governance             Json?    // extracted from Articles of Association
  extractedData          Json?    // merged snapshot from per-doc extractions
  extractionVersion      String?  // 'v1' for now; bump if prompts change
  // ───────────────────────────────────────────────────────────────────────────

  status     String   @default("PENDING")
  reviewNote String?
  reviewedAt DateTime?
  reviewedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// KYC SUBMISSION (manual — admin reviews)
// ═══════════════════════════════════════════════════════════════════════════════

model KycSubmission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  documents  SubmissionDocument[]

  status     String   @default("PENDING")
  reviewNote String?
  reviewedAt DateTime?
  reviewedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// SUBMISSION DOCUMENT (binary file stored in DB)
// ═══════════════════════════════════════════════════════════════════════════════

model SubmissionDocument {
  id     String @id @default(cuid())
  userId String

  kybSubmissionId String?
  kybSubmission   KybSubmission? @relation(fields: [kybSubmissionId], references: [id], onDelete: Cascade)

  kycSubmissionId String?
  kycSubmission   KycSubmission? @relation(fields: [kycSubmissionId], references: [id], onDelete: Cascade)

  creditScoreRequestId String?
  creditScoreRequest   CreditScoreRequest? @relation(fields: [creditScoreRequestId], references: [id], onDelete: Cascade)

  fieldName String
  filename  String
  mimeType  String
  sizeBytes Int
  content   Bytes

  extractions DocumentExtraction[]

  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════════
// DOCUMENT EXTRACTION (P2 — v3.27 — Claude per-document extraction job)
// ═══════════════════════════════════════════════════════════════════════════════

enum ExtractionStatus {
  PENDING
  EXTRACTING
  COMPLETED
  FAILED
}

model DocumentExtraction {
  id         String              @id @default(cuid())
  documentId String
  document   SubmissionDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  docType             String   // 'incorporation' | 'articles' | 'shareholders' | 'balance_sheet' | 'income_statement' | 'cash_flow'
  status              ExtractionStatus @default(PENDING)

  modelName           String?  // e.g. 'claude-sonnet-4-6'
  systemPromptVersion String?  // e.g. 'kyb-incorporation-v1'
  rawResponse         String?  // full Claude response — for audit / prompt tuning
  extractedData       Json?    // parsed structured data
  confidence          Json?    // per-field 0..1
  promptTokens        Int?
  completionTokens    Int?
  errorMessage        String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([documentId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════════
// CREDIT SCORE REQUEST
// ═══════════════════════════════════════════════════════════════════════════════

model CreditScoreRequest {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  incomeStatementCid   String?
  balanceSheetCid      String?
  cashFlowCid          String?
  period               String?

  annualRevenue        String?
  netProfit            String?
  totalAssets          String?
  totalLiabilities     String?
  employeeCount        Int?
  yearsOperating       Int?
  existingDebt         String?
  monthlyExpenses      String?
  additionalContext    String?

  status               CreditScoreStatus @default(PENDING)
  score                Int?
  rating               String?
  approved             Boolean?
  maxCreditLimit       String?
  analysisNotes        String?
  rejectionReason      String?

  n8nExecutionId       String?
  submittedToN8nAt     DateTime?
  n8nCallbackAt        DateTime?

  // Custom doc-upload flow (P4 — v3.28) — Claude extraction + preliminary score
  extractedLineItems   Json?    // merged FinancialLineItems from the 3 statements
  extractedIndicators  Json?    // computed IndicatorBreakdown
  computedScore        Int?     // algorithm's preliminary 0-100 score (admin may override `score`)
  computedTier         String?  // EXCELLENT | GOOD | FAIR | POOR
  extractionVersion    String?  // 'v1'

  nftTokenId           String?
  nftMintedAt          DateTime?

  documents            SubmissionDocument[]

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// BANK ACCOUNT
// ═══════════════════════════════════════════════════════════════════════════════

model BankAccount {
  id                     String            @id @default(cuid())
  userId                 String
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountName            String
  bankName               String
  accountNumberMasked    String
  accountNumberEncrypted String?
  accountType            BankAccountType
  currency               String            @default("COP")
  isDefault              Boolean           @default(false)

  holderName             String
  bankCountry            String
  documentType           String
  documentNumber         String
  bankAddress            String
  bankCity               String
  bankState              String?
  swiftCode              String?
  routingNumber          String?
  iban                   String?

  status                 BankAccountStatus @default(PENDING)
  verifiedAt             DateTime?
  verifiedBy             String?

  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// CONTACT
// ═══════════════════════════════════════════════════════════════════════════════

model Contact {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  address   String
  type      ContactType @default(OTHER)
  notes     String?
  avatarUrl String?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, address])
}

// ═══════════════════════════════════════════════════════════════════════════════
// DOCUMENT
// ═══════════════════════════════════════════════════════════════════════════════

model Document {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  filename      String
  mimeType      String
  sizeBytes     Int
  ipfsCid       String
  ipfsUrl       String
  pinataGroupId String?
  documentHash  String?
  category      DocumentCategory @default(GENERAL)

  vaultId       String?
  contractId    String?

  createdAt     DateTime         @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════════
// OTC ORDER
// ═══════════════════════════════════════════════════════════════════════════════

model OtcOrder {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId       String?        @unique
  orderType     OtcOrderType

  // Fiat-OTC fields (new format)
  digitalAsset  String?
  fiatCurrency  String?
  assetAmount   Decimal?       @db.Decimal(18, 6)
  estimatedFiat Decimal?       @db.Decimal(18, 2)
  rate          Decimal?       @db.Decimal(18, 6)
  walletAddress String?
  frontendTimestamp DateTime?

  // Sell order bank info
  bankName        String?
  bankAccount     String?
  bankAccountType String?
  holderName      String?
  accountLabel    String?

  // Legacy swap fields (optional for backward compat)
  tokenIn      String?
  tokenOut     String?
  amountIn     String?
  amountOut    String?
  priceUSD     String?
  network      String?

  status       OtcOrderStatus @default(PENDING)
  telegramSent Boolean        @default(false)
  emailSent    Boolean        @default(false)
  notes        String?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// FUNDING REQUEST (Business only)
// ═══════════════════════════════════════════════════════════════════════════════

model FundingRequest {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount       String
  currency     String               @default("USDC")
  purpose      String
  term         Int?
  interestRate String?
  collateral   String?

  status       FundingRequestStatus @default(PENDING)
  vaultId      String?

  adminNotes   String?
  reviewedBy   String?
  reviewedAt   DateTime?

  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// VAULT (on-chain TokenizedBondVault, created by VaultFactory)
// ═══════════════════════════════════════════════════════════════════════════════

model Vault {
  id              String   @id @default(cuid())

  // On-chain identifiers
  onchainVaultId  String   // uint256 from VaultFactory (stored as string)
  vaultAddress    String   @unique // TokenizedBondVault contract address
  chainId         Int      @default(84532)

  // Vault parameters (mirrors contract constructor args)
  name            String
  symbol          String
  principalAmount String   // USDC amount in smallest unit (6 dec)
  interestRate    String   // basis points e.g. "850" = 8.5%
  protocolFeeRate String   // basis points
  maturityDate    DateTime
  totalShareSupply String  // shares (6 dec)
  minInvestment   String   // USDC minimum (6 dec)
  borrowerAddress String   // address that can withdrawFunds()

  // Link to funding request
  fundingRequestId String? @unique
  txHash          String?  // deployment transaction hash

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// NOTIFICATION LOG
// ═══════════════════════════════════════════════════════════════════════════════

model NotificationLog {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel    NotificationChannel
  subject    String
  body       String
  recipient  String
  status     String
  externalId String?
  error      String?

  createdAt  DateTime            @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════════
// EXCHANGE RATE CACHE
// ═══════════════════════════════════════════════════════════════════════════════

model ExchangeRate {
  id        String   @id @default(cuid())
  pair      String   @unique
  rate      Float
  source    String
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// ADMIN ROLE
// ═══════════════════════════════════════════════════════════════════════════════

model AdminRole {
  id        String        @id @default(cuid())
  userId    String        @unique
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AdminRoleType @default(VIEWER)
  grantedBy String
  createdAt DateTime      @default(now())
}
