# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
APP_URL=https://your-service.up.railway.app
FRONTEND_URL=https://your-frontend.vercel.app

# ─── Database ─────────────────────────────────────────────────────────────────
# On Railway: set as ${{Postgres.DATABASE_URL}} reference variable
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Redis ────────────────────────────────────────────────────────────────────
# On Railway: set as ${{Redis.REDIS_URL}} reference variable
REDIS_URL=redis://host:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=your-strong-secret-minimum-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Pinata IPFS ──────────────────────────────────────────────────────────────
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_KEY=
PINATA_GATEWAY=lime-famous-condor-7.mypinata.cloud

# ─── Veriff (Individual KYC) ──────────────────────────────────────────────────
VERIFF_API_KEY=
VERIFF_BASE_URL=https://stationapi.veriff.com
VERIFF_WEBHOOK_SECRET=

# ─── Sumsub (Business KYB) ────────────────────────────────────────────────────
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_WEBHOOK_SECRET=

# ─── n8n (Credit Score Automation) ───────────────────────────────────────────
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ─── Notifications ────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=financial@convexo.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=

# ─── Network Mode ─────────────────────────────────────────────────────────────
# 'mainnet' → Base Mainnet (8453) as primary chain
# 'testnet' → ETH Sepolia (11155111) as primary chain (ZKPassport verifier + pool live)
NETWORK_MODE=testnet

# ─── Blockchain RPC ───────────────────────────────────────────────────────────
ETHEREUM_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
BASE_MAINNET_RPC_URL=https://base-mainnet.infura.io/v3/YOUR_KEY
BASE_SEPOLIA_RPC_URL=https://base-sepolia.infura.io/v3/YOUR_KEY
UNICHAIN_MAINNET_RPC_URL=https://mainnet.unichain.org
UNICHAIN_SEPOLIA_RPC_URL=https://sepolia.unichain.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# ─── Exchange Rates ───────────────────────────────────────────────────────────
EXCHANGE_RATE_API_KEY=
RATES_CACHE_TTL_SECONDS=600

# ─── Encryption ───────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32 (required — used for AES-256-GCM bank account encryption)
ENCRYPTION_KEY=

# ─── API Docs ─────────────────────────────────────────────────────────────────
# Secret token to access /docs in production. Access via: /docs?token=<secret>
# Generate: openssl rand -hex 16
DOCS_SECRET=

# ─── Admin Bootstrap ──────────────────────────────────────────────────────────
# Comma-separated wallet addresses granted SUPER_ADMIN on startup
ADMIN_WALLET_ADDRESSES=

# ─── Pool Keeper ──────────────────────────────────────────────────────────────
# EOA private key with KEEPER_ROLE on PassportGatedHook (for keeper rebalance)
# Generate a dedicated EOA — do NOT reuse the deployer key
KEEPER_PRIVATE_KEY=0x...


# Contract addresses for the active network (set per NETWORK_MODE)
# ETH Sepolia (testnet): hook=0xd3f980f48638783a8324ff99301028f08bda8a80
CONVEXO_HOOK_ADDRESS=0x...
USDC_ADDRESS=0x...
ECOP_ADDRESS=0x...
# After deploying ManualPriceAggregator (Phase B): set to deployed address
MANUAL_PRICE_AGGREGATOR_ADDRESS=0x...

# Chain the pool keeper monitors. Must match your NETWORK_MODE primary chain.
# ETH Sepolia = 11155111, Base Mainnet = 8453
POOL_KEEPER_CHAIN_ID=11155111
